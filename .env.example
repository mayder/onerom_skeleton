# Copy this file to .env only for local development.
# Never commit real tokens, cookies, credentials, customer data, or production URLs.

# Runner-agent API base used by onerom_core when running inside Onerom.
# Examples:
# ONEROM_API_URL=https://example.com/api/v1
# ONEROM_API_URL=https://example.com/api/v1/runner-agent
ONEROM_API_URL=

# Runner key is injected by the Onerom Runner in real executions.
ONEROM_RUNNER_KEY=

# Optional local smoke settings.
BOT_LOCAL_MODE=true
BOT_LOG_LEVEL=INFO
BOT_PROJECT_ROOT=.
BOT_INPUTS_DIR=inputs
BOT_OUTPUTS_DIR=outputs
BOT_EVIDENCE_DIR=evidence
BOT_ARTIFACTS_DIR=artifacts
BOT_LOGS_DIR=logs
